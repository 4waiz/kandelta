nce we eat."},{"startSeconds":57.005,"endSeconds":58.005,"text":"Thank you."}],"frames":[{"id":"med_6efc2e748bd7981a6d1e4fcd66af","position":1,"timestampSeconds":1.07,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/1_1.07.webp"},{"id":"med_7c41da482e872665a2eba73657d6","position":2,"timestampSeconds":1.9,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/2_1.90.webp"},{"id":"med_31b7321962f715a36ad73d555a63","position":3,"timestampSeconds":2.67,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/3_2.67.webp"},{"id":"med_1833fdc40c115ecf5bdf4383893f","position":4,"timestampSeconds":3.33,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/4_3.33.webp"},{"id":"med_39da9ddf3b172c1ade4cd3058b7a","position":5,"timestampSeconds":4.1,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/5_4.10.webp"},{"id":"med_05b77b8c2efe428348a8d561d8ef","position":6,"timestampSeconds":4.17,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/6_4.17.webp"},{"id":"med_f93514640fb3dc2daa110a56c4f2","position":7,"timestampSeconds":4.2,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/7_4.20.webp"},{"id":"med_81020563665d68958b8e56cb6ffd","position":8,"timestampSeconds":4.7,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/8_4.70.webp"},{"id":"med_27e72c5a73080e158e54591c0ae0","position":9,"timestampSeconds":5.53,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/9_5.53.webp"},{"id":"med_98c6eae5f824930ca727ad4bfe91","position":10,"timestampSeconds":6.27,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/10_6.27.webp"},{"id":"med_ce22d07fea2feded13a435f49c10","position":11,"timestampSeconds":6.93,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Dac9LGQOpbg/11_6.93.webp"},{"id":"med_8d47d3e85e09bfafddd154685206",