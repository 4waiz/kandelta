":"I'll do this, I'll do it."},{"startSeconds":23.043,"endSeconds":23.683,"text":"What do I do?"},{"startSeconds":23.683,"endSeconds":24.683,"text":"Confusion, remove acne."},{"startSeconds":24.683,"endSeconds":27.043,"text":"Just use acne style gel."},{"startSeconds":30.003,"endSeconds":32.643,"text":"This skin will not make a soft or soft."},{"startSeconds":32.643,"endSeconds":34.043,"text":"It will only remove acne."},{"startSeconds":38.203,"endSeconds":40.683,"text":"This is the clindamycin and nicotinamide."},{"startSeconds":40.683,"endSeconds":44.883,"text":"Which will remove acne, blackheads, whiteheads and oiliness."},{"startSeconds":44.883,"endSeconds":47.323,"text":"And make a skin radiant for 7 days."},{"startSeconds":47.323,"endSeconds":48.243,"text":"You do you."},{"startSeconds":48.243,"endSeconds":49.403,"text":"Acne stars got you."}],"frames":[{"id":"med_405b7d280fab3acb94320eab0e02","position":1,"timestampSeconds":0.8,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Db7ag8jq8uO/1_0.80.webp"},{"id":"med_d0ae6d169895a5de2a0b11b6901b","position":2,"timestampSeconds":1.76,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Db7ag8jq8uO/2_1.76.webp"},{"id":"med_2a871f24b5f7adbe6c856c90675c","position":3,"timestampSeconds":1.96,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Db7ag8jq8uO/3_1.96.webp"},{"id":"med_478091365e780408749fd5d6534b","position":4,"timestampSeconds":2.68,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Db7ag8jq8uO/4_2.68.webp"},{"id":"med_6c33d47014ecc6a39b7ee8fecda2","position":5,"timestampSeconds":4.16,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Db7ag8jq8uO/5_4.16.webp"},{"id":"med_64a5a8f19b82d295d4b0ff669cb6","position":6,"timestampSeconds":6.04,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/Db7ag8jq8uO/6_6.04.webp"},{"id":"med_493014063e0c50864e0ec1ad5d69","position":7,"timestampSeconds":10.2,"url":"https://oriane-frames.s3