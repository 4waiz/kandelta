{"platformId":"7676565720089051918","profilePlatformId":"7364663601984128046","profileHandle":"rbid9ke3b3782k","content":"facebook","likesCount":0,"repliesCount":0,"publishedAt":"2026-08-21T19:16:20.000Z","createdAt":"2026-08-23T13:01:11.775Z","updatedAt":"2026-08-23T13:01:11.775Z"},{"platformId":"7675984362722984734","profilePlatformId":"6779748743648560133","profileHandle":"tiffanieandchloe","content":"I’m","likesCount":0,"repliesCount":1,"publishedAt":"2026-08-20T05:40:30.000Z","createdAt":"2026-08-23T13:01:11.775Z","updatedAt":"2026-08-23T13:01:11.775Z"},{"platformId":"7671064074918839053","profilePlatformId":"7055713629094052870","profileHandle":"sabrinakarim922","content":"@Dr. Scott Walter | Derm what’s your thoughts on medicube’s hair regrowth product? https://www.tiktok.com/view/product/1732406488217719019?_t=ZT-98fXyERl6zu","likesCount":0,"repliesCount":1,"publishedAt":"2026-08-06T23:26:59.000Z","createdAt":"2026-08-23T13:01:11.775Z","updatedAt":"2026-08-23T13:01:11.775Z"},{"platformId":"7667773844199867149","profilePlatformId":"6882512365868073989","profileHandle":"carterk113","content":"Could you share some your favorite pregnancy-safe skincare options?","likesCount":0,"repliesCount":0,"publishedAt":"2026-07-29T02:39:22.000Z","createdAt":"2026-08-23T13:01:11.775Z","updatedAt":"2026-08-23T13:01:11.775Z"}],"createdAt":"2026-08-06T22:09:27.092Z","updatedAt":"2026-09-25T08:51:21.854Z"},{"id":"cnt_04fa0a7774f8b6756b519eda58ee","matchedQueries":[],"platform":"instagram","profileHandle":"goharsguide","profileDisplayName":"Gohar Khan","format":"video","caption":"levels of skincare 🧼 (college essay review in bio!) #student #life #advice #skincare","captionLanguage":"en","thumbnailMediaId":"med_730befe4ac5dd71714e751658432","publishedAt":"2026-09-13T16:31:19.000Z","profileId":"prf_fb16afb3c04ab83f309be0aedac4","thumbnailMediaUrl":"https://oriane-contents.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/thumbnail.webp","viewsCount":4806624,"likesCount":123247,"sharesCount":20200,"commentsCount":559,"interactionsCount":144006,"engagementRatePerViews":2.9959905330643712,"engagementRatePerFollowers":10.253485505806863,"profileFollowersCount":1404459,"profileFollowingCount":425,"profilePostsCount":730,"mediaCount":1,"duration":34.833,"hashtags":["#student","#life","#advice","#skincare"],"coAuthors":[],"mentions":[],"platformId":"DdO_pOFJ3mi","profilePlatformId":"40904747468","profilePictureUrl":"https://oriane-handles.s3.us-east-1.amazonaws.com/instagram/goharsguide/pfp.webp","profileBio":"📚 MIT grad helping you survive college and life!\n🎥 YouTube: goharsguide (7M+)\n✉️ support@nextadmit.com\n👇 Get college essay help","profileVerified":true,"locationPlatformId":null,"locationCompleteAddress":null,"locationLatitude":null,"locationLongitude":null,"profileLocationPlatformId":null,"profileLocationCompleteAddress":null,"profileLocationLatitude":null,"profileLocationLongitude":null,"transcript":"You rub a bar of soap on your face before bed, but wake up with acne. So you swap the soap with the cleanser meant for your face. But as soon as you leave the house, your face feels a little dry. That's why the next day you follow up the cleanser with a moisturizer. But after just a few hours outside, you notice a good amount of sunburn. So the next morning, you use cleanser, moisturizer, and sunscreen to protect your face. But after 20 years, you notice your first wrinkle. So that's why you mix together a cleanser, vitamin C serum, moisturizer, and then sunscreen. And also Gohar's account for more tips.","transcriptLanguage":"en","transcriptChunks":[{"startSeconds":0.013,"endSeconds":3.733,"text":"You rub a bar of soap on your face before bed, but wake up with acne."},{"startSeconds":4.033,"endSeconds":7.073,"text":"So you swap the soap with the cleanser meant for your face."},{"startSeconds":7.233,"endSeconds":10.593,"text":"But as soon as you leave the house, your face feels a little dry."},{"startSeconds":10.893,"endSeconds":14.213,"text":"That's why the next day you follow up the cleanser with a moisturizer."},{"startSeconds":14.733,"endSeconds":18.813,"text":"But after just a few hours outside, you notice a good amount of sunburn."},{"startSeconds":19.073,"endSeconds":24.233,"text":"So the next morning, you use cleanser, moisturizer, and sunscreen to protect your face."},{"startSeconds":24.233,"endSeconds":27.253,"text":"But after 20 years, you notice your first wrinkle."},{"startSeconds":27.253,"endSeconds":32.473,"text":"So that's why you mix together a cleanser, vitamin C serum, moisturizer, and then sunscreen."},{"startSeconds":32.733,"endSeconds":34.593,"text":"And also Gohar's account for more tips."}],"frames":[{"id":"med_d47405d74005748446e4bb6283f4","position":1,"timestampSeconds":0.53,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/1_0.53.webp"},{"id":"med_7d306d165db08bdd8916536fe296","position":2,"timestampSeconds":1.67,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/2_1.67.webp"},{"id":"med_7e0ef023b7ee7fbfd9045ad4a04c","position":3,"timestampSeconds":2.5,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/3_2.50.webp"},{"id":"med_c28498172a8c4204a633ba977459","position":4,"timestampSeconds":2.54,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/4_2.54.webp"},{"id":"med_8c4534b7ab1bbb39607a35e2df8a","position":5,"timestampSeconds":3.77,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/5_3.77.webp"},{"id":"med_54d8e0eb3d61218dfa3692fb058b","position":6,"timestampSeconds":4.8,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/6_4.80.webp"},{"id":"med_5d1c52a10a423717bf6131819540","position":7,"timestampSeconds":6.11,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DdO_pOFJ3mi/7_6.11.webp"},{"id":"med_675f3398215a0032e030598b2d80","position":8,"timestampSeconds":7.27,"url":"https://oriane-frames.s3.us-east