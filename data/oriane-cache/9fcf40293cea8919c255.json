-08-26T17:13:52.000Z","createdAt":"2026-09-21T01:02:53.136Z","updatedAt":"2026-09-21T01:02:53.136Z"}],"createdAt":"2026-09-20T13:52:39.625Z","updatedAt":"2026-09-22T15:26:04.729Z"},{"id":"cnt_0c8dff9f5e01cbef144b5bf7d91f","matchedQueries":[],"platform":"tiktok","profileHandle":"flywithhaifa","profileDisplayName":"Fly With Haifa","format":"video","caption":"I am absolutely impressed and in love with @tashkeelstudio 💖 🎨  The haven that artists in #Dubai need! I remember having so many conversations with #artits where we wished for a place like this! @tashkeelstudio not only offers an art incubator, but also offers workshops, they organize galleries, events, and have incredible MACHINES that help artists creations come to reality! PRINT YOUR IDEAS OUT ❤️‍🔥❤️‍🔥❤️‍🔥 Then they go ahead and feature some in their tashkeel shop! I find this very empowering and a whole 360 approach. We also got to visit their #Emirati find dinning restaurant called @Gazebo Do you know it’s ranked number 16 world wide in terms of beauty! Check it out in the video  Or better even go visit the whole place urself or with an artistic friend 🤍 Keep dreaming folks There are amazing things out there we just gotta find them, and special thanks to the @tashkeel studio team","captionLanguage":"en","thumbnailMediaId":"med_f6930ed009f78077fe862b7e3c77","publishedAt":"2026-08-26T13:24:15.000Z","profileId":"prf_8d4224a4af27b66ee668cd503864","thumbnailMediaUrl":"https://oriane-contents.s3.us-east-1.amazonaws.com/tiktok/7678330570610461973/thumbnail.webp","viewsCount":8463,"likesCount":107,"sharesCount":2,"commentsCount":1,"interactionsCount":110,"engagementRatePerViews":1.2997754933238803,"engagementRatePerFollowers":0.07676203768318214,"profileFollowersCount":143300,"profileFollowingCount":25,"profilePostsCount":298,"mediaCount":1,"duration":96,"hashtags":["#dubai","#artits","#emirati"],"coAuthors":[],"mentions":[],"platformId":"7678330570610461973","profilePlatformId":"6765903961720914950","profilePictureU