ePerViews":0.47812264150943395,"engagementRatePerFollowers":2.203521739130435,"profileFollowersCount":2300000,"profileFollowingCount":80,"profilePostsCount":568,"mediaCount":1,"duration":44,"hashtags":["#marynmay","#spicule","#collagen","#retinol","#pdrn"],"coAuthors":[],"mentions":[{"id":"prf_d5d6415cf4f5c7adb4cb1b41f628","platformId":"7207621482040968198","profileHandle":"marynmay_official"}],"platformId":"7664066239039343892","profilePlatformId":"7337536689134404626","profilePictureUrl":"https://oriane-handles.s3.us-east-1.amazonaws.com/tiktok/blueeyedkaylajade/pfp.webp","profileBio":"lG itsmekaylajade\n💌 kaylajadeteam@bedou.com.au","profileVerified":true,"locationPlatformId":null,"locationCompleteAddress":null,"locationLatitude":null,"locationLongitude":null,"profileLocationPlatformId":null,"profileLocationCompleteAddress":null,"profileLocationLatitude":null,"profileLocationLongitude":null,"transcript":"Skincare with microneedles in it. Ouch. Don't be afraid of the tingle. It's all part of the process to get nice, glowy. You guys know I love Korean skincare. And these contain microspicules, which are apparently these tiny needles that open pathways for active ingredients to be absorbed into the skin better. Kind of like microneedling. But don't worry, they don't stay in your skin. You naturally shed over time with your dead skin. Collagen is used in the daytime. Well, the retinol is best used at night. Both are meant to improve skin texture, firmness, and radiance. This is before and after. I just love the glow that it gives my skin. Don't worry, you don't have to put all the dots on your face. Bye, guys.","transcriptLanguage":"en","transcriptChunks":[{"startSeconds":0.004,"endSeconds":1.924,"text":"Skincare with microneedles in it."},{"startSeconds":2.624,"endSeconds":2.984,"text":"Ouch."},{"startSeconds":3.604,"endSeconds":4.964,"text":"Don't be afraid of the tingle."},{"startSeconds":5.064,"endSeconds":7.524,"text":"It's all part of the process to get nice, glowy."},{"startSeconds":7.624,"endSeconds":9.764,"text":"You guys know I love Korean skincare."},{"startSeconds":10.064,"endSeconds":12.444,"text":"And these contain microspicules,"},{"startSeconds":12.644,"endSeconds":15.704,"text":"which are apparently these tiny needles that open pathways"},{"startSeconds":15.704,"endSeconds":19.084,"text":"for active ingredients to be absorbed into the skin better."},{"startSeconds":19.164,"endSeconds":20.344,"text":"Kind of like microneedling."},{"startSeconds":20.504,"endSeconds":22.784,"text":"But don't worry, they don't stay in your skin."},{"startSeconds":22.984,"endSeconds":26.024,"text":"You naturally shed over time with your dead skin."},{"startSeconds":26.304,"endSeconds":28.524,"text":"Collagen is used in the daytime."},{"startSeconds":28.524,"endSeconds":31.784,"text":"Well, the retinol is best used at night."},{"startSeconds":31.984,"endSeconds":35.204,"text":"Both are meant to improve skin texture, firmness, and radiance."},{"startSeconds":35.344,"endSeconds":38.004,"text":"This is before and after."},{"startSeconds":38.864,"endSeconds":41.004,"text":"I just love the glow that it gives my skin."},{"startSeconds":41.084,"endSeconds":43.224,"text":"Don't worry, you don't have to put all the dots on your face."},{"startSeconds":43.364,"endSeconds":43.824,"text":"Bye, guys."}],"frames":[{"id":"med_3478a103c9026a231986248aaa6a","position":1,"timestampSeconds":1.93,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7664066239039343892/1_1.93.webp"},{"id":"med_5583a6c528f2137b4a74bc23d867","position":2,"timestampSeconds":2.7,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7664066239039343892/2_2.70.webp"},{"id":"med_56b1293df01976f9f13eaaf3d890","position":3,"timestampSeconds":3.6,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7664066239039343892/3_3.60.webp"},{"id":"med_1d7ba862439ac7f133d7b6217410","position":4,"timestampSeconds":7.67,"url":"https://oriane-frames.s3.us-east-1.am