:14.53,"text":"K速"},{"startSeconds":15.03,"endSeconds":16.57,"text":"尤其是在掉头的时候特别不准"},{"startSeconds":18.11,"endSeconds":19.39,"text":"外观还需要美观"},{"startSeconds":19.39,"endSeconds":20.41,"text":"还需要续航久"},{"startSeconds":20.67,"endSeconds":21.95,"text":"还有这个佩戴舒适"},{"startSeconds":22.21,"endSeconds":25.01,"text":"这么多因素就构成了一个所谓的不可能三角"},{"startSeconds":26.29,"endSeconds":27.33,"text":"对于我们来说"},{"startSeconds":27.33,"endSeconds":29.89,"text":"我们就是要想办法去把这个不可能三角"},{"startSeconds":29.89,"endSeconds":31.17,"text":"让它变成可能"},{"startSeconds":31.93,"endSeconds":35.27,"text":"硬件上我们做了3D立体悬浮式天线"},{"startSeconds":35.53,"endSeconds":38.33,"text":"软件上我们有智慧化动态识别方案"},{"startSeconds":39.11,"endSeconds":42.43,"text":"这样软件硬件结合就形成了我们的向日葵天线技术"},{"startSeconds":43.97,"endSeconds":46.79,"text":"我们还推出了AXDR定位算法"},{"startSeconds":47.05,"endSeconds":49.09,"text":"即便是在没有卫星信号的隧道里"},{"startSeconds":49.35,"endSeconds":51.91,"text":"也能还原真实的轨迹和精准的配速"}],"frames":[{"id":"med_c74d69436020d149e2d10baa6d2b","position":1,"timestampSeconds":1.07,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7656698077025275154/1_1.07.webp"},{"id":"med_04cf93ea4045936c69f6bd729fcf","position":2,"timestampSeconds":2.87,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7656698077025275154/2_2.87.webp"},{"id":"med_3aa18de9e341ccb15b8eb6eb9e8f","position":3,"timestampSeconds":2.9,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7656698077025275154/3_2.90.webp"},{"id":"med_4641a4a192b9ecd3ab3528fab719","position":4,"timestampSeconds":2.93,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7656698077025275154/4_2.93.webp"},{"id":"med_a6a208295065e7c58e287bdee1d8","position":5,"timestampSeconds":3.03,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7656698077025275154/5_3.03.webp"},{"id":"med_8236d829b52e3b891480a2f75fa1","position":6,"timestampSeconds":3.07,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7656698077025275154/6_3.07.webp"},{"id":"med_34a