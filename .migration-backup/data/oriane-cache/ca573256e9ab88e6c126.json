s":0.7294153827228834,"engagementRatePerFollowers":1.0588571428571427,"profileFollowersCount":3256276,"profileFollowingCount":988,"profilePostsCount":886,"mediaCount":1,"duration":49.208,"hashtags":["#ad","#createdwithadidas"],"coAuthors":[],"mentions":[{"id":"prf_92645349ca09580dc45cb150a5f6","platformId":"536176622","profileHandle":"adidasrunning"}],"platformId":"DbVueLuoHG1","profilePlatformId":"48537154","profilePictureUrl":"https://oriane-handles.s3.us-east-1.amazonaws.com/instagram/cleoabram/pfp.webp","profileBio":"Video journalist making HUGE* If True, an optimistic show about science and tech. Prev: Vox, Netflix.\nWatch our new episode 👇","profileVerified":true,"locationPlatformId":null,"locationCompleteAddress":null,"locationLatitude":null,"locationLongitude":null,"profileLocationPlatformId":null,"profileLocationCompleteAddress":null,"profileLocationLatitude":null,"profileLocationLongitude":null,"transcript":"The foam inside this shoe is like nothing I've ever seen. And I'm testing them out. Okay, so in your running shoe, you have the upper piece, which comfortably holds your foot, the outsole, which hits the ground, and the midsole, which determines every time your foot hits the ground, how much energy you get back. That's energy return. A normal energy return is about 60%, but this shoe, independent studies are showing 74%. Can you see those bumps? That's because of the way it's made. With special beads like this for years, in order to make a shoe this bouncy, you needed to put a stiff carbon fiber plate inside, which is great for energy return on race day. But in your everyday runs, it can be a little punishing, but this shoe doesn't need it. And it's still all based in performance and grounded in race innovation for all this energy return. If you want to try them with me, search for Adidas Hyper Boost or go to this link.","transcriptLanguage":"en","transcriptChunks":[{"startSeconds":0.003,"endSeconds":3.543,"text":"The foam inside this shoe is like nothing I've ever seen."},{"startSeconds":3.543,"endSeconds":4.463,"text":"And I'm testing them out."},{"startSeconds":4.463,"endSeconds":5.603,"text":"Okay, so in your running shoe,"},{"startSeconds":5.603,"endSeconds":8.523,"text":"you have the upper piece, which comfortably holds your foot,"},{"startSeconds":8.523,"endSeconds":10.483,"text":"the outsole, which hits the ground,"},{"startSeconds":10.483,"endSeconds":12.263,"text":"and the midsole, which determines"},{"startSeconds":12.263,"endSeconds":13.943,"text":"every time your foot hits the ground,"},{"startSeconds":13.943,"endSeconds":15.703,"text":"how much energy you get back."},{"startSeconds":15.703,"endSeconds":16.963,"text":"That's energy return."},{"startSeconds":16.963,"endSeconds":20.943,"text":"A normal energy return is about 60%,"},{"startSeconds":20.943,"endSeconds":25.823,"text":"but this shoe, independent studies are showing 74%."},{"startSeconds":25.823,"endSeconds":27.143,"text":"Can you see those bumps?"},{"startSeconds":27.143,"endSeconds":28.563,"text":"That's because of the way it's made."},{"startSeconds":28.563,"endSeconds":31.043,"text":"With special beads like this for years,"},{"startSeconds":31.043,"endSeconds":32.583,"text":"in order to make a shoe this bouncy,"},{"startSeconds":32.583,"endSeconds":35.583,"text":"you needed to put a stiff carbon fiber plate inside,"},{"startSeconds":35.583,"endSeconds":37.523,"text":"which is great for energy return on race day."},{"startSeconds":37.523,"endSeconds":40.043,"text":"But in your everyday runs, it can be a little punishing,"},{"startSeconds":40.043,"endSeconds":42.143,"text":"but this shoe doesn't need it."},{"startSeconds":42.143,"endSeconds":43.483,"text":"And it's still all based in performance"},{"startSeconds":43.483,"endSeconds":46.183,"text":"and grounded in race innovation for all this energy return."},{"startSeconds":46.183,"endSeconds":47.043,"text":"If you want to try them with me,"},{"startSeconds":47.043,"endSeconds":49.443,"text":"search for Adidas Hyper Boost or go to this link."}],"frames":[{"id":"med_eab86a52b492cded726992d8187d","position":1,"timestampSeconds":0.04,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/1_0.04.webp"},{"id":"med_81d73a25d3ae5e64bc3e6b5cdced","position":2,"timestampSeconds":0.71,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/2_0.71.webp"},{"id":"med_c4a80e081a75771ace039df5b952","position":3,"timestampSeconds":0.75,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/3_0.75.webp"},{"id":"med_77502586dea3c9efec249b381cb5","position":4,"timestampSeconds":2.25,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/4_2.25.webp"},{"id":"med_a5f1aa7a4a76a8802ea9553b3e4b","position":5,"timestampSeconds":2.29,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/5_2.29.webp"},{"id":"med_b61c57d9a6cbc863623e9e360dce","position":6,"timestampSeconds":3.54,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/6_3.54.webp"},{"id":"med_deca3e9dcb95a33f2c2f622df54e","position":7,"timestampSeconds":3.58,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/7_3.58.webp"},{"id":"med_28c606af377417982e03acdc9e12","position":8,"timestampSeconds":4.46,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/8_4.46.webp"},{"id":"med_49e3737c45573d44aeae8238b703","position":9,"timestampSeconds":12.29,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/9_12.29.webp"},{"id":"med_d4f1cf2383fa994bff6a6f56a344","position":10,"timestampSeconds":12.33,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/10_12.33.webp"},{"id":"med_0e1cf381a3f7e1f8d831cf9813c2","position":11,"timestampSeconds":15.79,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DbVueLuoHG1/11_15.79.webp"},{"id":"med_753af494cc72d0eed4b1858cd98e","position":