 fuimos literalmente a un parque, colocamos allí los aros y nos montamos nuestra propia partida 😅 Es un deporte muy sencillo, pero bastante entretenido y perfecto para jugar en familia o con amigos y pasar un buen rato haciendo algo diferente. Habías jugado alguna vez al croquet?👀 #croquet #probandodeportes #deportealairelibre #deportesenfamilia #nuevosdeportes","captionLanguage":"es","thumbnailMediaId":"med_c53683063fa246e34b9d5383bd7d","publishedAt":"2026-08-17T19:33:21.000Z","profileId":"prf_8ba1dce153645584d5c443978570","thumbnailMediaUrl":"https://oriane-contents.s3.us-east-1.amazonaws.com/tiktok/7675085935213579552/thumbnail.webp","viewsCount":11400,"likesCount":1124,"sharesCount":10,"commentsCount":12,"interactionsCount":1146,"engagementRatePerViews":10.052631578947368,"engagementRatePerFollowers":8.070422535211268,"profileFollowersCount":14200,"profileFollowingCount":516,"profilePostsCount":1370,"mediaCount":1,"duration":35,"hashtags":["#croquet","#probandodeportes","#deportealairelibre","#deportesenfamilia","#nuevosdeportes"],"coAuthors":[],"mentions":[]},{"id":"cnt_a1f3fdaf42efd857c19d97b7e7cb","matchedQueries":[],"platform":"tiktok","profileHandle":"violetamorgan","profileDisplayName":"VIOLETA 💜","format":"video","caption":"🌞","captionLanguage":null,"thumbnailMediaId":"med_a95b515e95f1dece31c6774ce2d5","publishedAt":"2026-08-16T13:41:02.000Z","profileId":"prf_8ba1dce153645584d5c443978570","thumbnailMediaUrl":"https://oriane-contents.s3.us-east-1.amazonaws.com/tiktok/7674624050634820897/thumbnail.webp","viewsCount":3142,"likesCount":172,"sharesCount":5,"commentsCount":3,"interactionsCount":180,"engagementRatePerViews":5.728835136855507,"engagementRatePerFollowers":1.267605633802817,"profileFollowersCount":14200,"profileFollowingCount":516,"profilePostsCount":1370,"mediaCount":1,"duration":17,"hashtags":[],"coAuthors":[],"mentions":[]},{"id":"cnt_10bc58fad3f5af20577b1f1b4c45","matchedQueries":[],"platform":"tiktok","profileHandle":"violetamorgan","profileDi