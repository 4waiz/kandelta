ds":22.9,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/18_22.90.webp"},{"id":"med_abc54bd55216be287d46f949235b","position":19,"timestampSeconds":23.97,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/19_23.97.webp"},{"id":"med_554bf40593ce46fd1e1a8c3579fc","position":20,"timestampSeconds":24.8,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/20_24.80.webp"},{"id":"med_95e98e806f056a3c6ec61ef67aa2","position":21,"timestampSeconds":25.73,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/21_25.73.webp"},{"id":"med_7086d96c8b5cd1b9ad1eff41caf9","position":22,"timestampSeconds":26.57,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/22_26.57.webp"},{"id":"med_13bbf7978db77e0c38106dfbb9a2","position":23,"timestampSeconds":27.3,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/23_27.30.webp"},{"id":"med_fcb373aeb8efbe3487728f916721","position":24,"timestampSeconds":28.6,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/24_28.60.webp"},{"id":"med_76aaf018625182755562eefd00aa","position":25,"timestampSeconds":29.33,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/25_29.33.webp"},{"id":"med_6c977aae3eaaa14e55fde4dcd2a2","position":26,"timestampSeconds":29.93,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/26_29.93.webp"},{"id":"med_cdd0737c4b4a6e6da97bc0a888ab","position":27,"timestampSeconds":30.73,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/27_30.73.webp"},{"id":"med_353a91d1b6cfbe3f3a19ea2aed97","position":28,"timestampSeconds":31.57,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/28_31.57.webp"},{"id":"med_e836443ed2b12d87a7b4fdb74e97","position":29,"timestampSeconds":32.27,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/29_32.27.webp"},{"id":"med_45ee9903777da526745198607a33","position":30,"timestampSeconds":33.53,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/30_33.53.webp"},{"id":"med_22faab8001863478fa709e577e12","position":31,"timestampSeconds":34.07,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/31_34.07.webp"},{"id":"med_ac4908d0bc0aa001ae06faeb4a68","position":32,"timestampSeconds":35.37,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/32_35.37.webp"}],"audioPlatformId":"7659572385733561119","audioTitle":"original sound","audioAuthor":"Lucy Smith","audioType":"original","audioCopyrighted":false,"popularComments":[{"platformId":"7660640886904570637","profilePlatformId":null,"profileHandle":"mchristine425","content":"Do you have a pizza 🍕 dough recipe?","likesCount":0,"repliesCount":0,"publishedAt":"2026-07-09T21:19:43.000Z","createdAt":"2026-07-14T02:28:41.626Z","updatedAt":"2026-07-14T02:28:41.626Z"},{"platformId":"7660231163625194254","profilePlatformId":null,"profileHandle":"thetessasmith","content":"The best!!!","likesCount":0,"repliesCount":0,"publishedAt":"2026-07-08T18:49:44.000Z","createdAt":"2026-07-14T02:28:41.626Z","updatedAt":"2026-07-14T02:28:41.626Z"}],"createdAt":"2026-07-13T14:07:32.628Z","updatedAt":"2026-09-25T08:44:23.569Z"},{"id":"cnt_6473acf802a8e1cb7e50d8f2e412","matchedQueries":[],"platform":"instagram","profileHandle":"morethangardening","profileDisplayName":"Sam | More than Gardening","format":"video","caption":"#ad #BallHomeCanningAmbassador you guys are going to love this Dill Relish recipe from the 38th Edition @ballcanning Blue Book Guide to Preserving !!! This is my new go to condiment for burgers & brats and I might even like this better than my pickles right now... full recipe below :)\n\nDill Relish from the 38th Edition Ball® Blue Book Guide to Preserving\n\nYield: about 7 pint jars \n8 pounds pickling cucumbers \n1/2 cup salt for canning and pickling \n2 teaspoons turmeric \n1 quart water \n1 pound yellow onions (about 3 medium) \n1/3 cup sugar \n2 tablespoons dill seed \n1 quart white wine vinegar, at least 5% acidity \nBall Pickle Crisp (optional)\n\nPREP Wash cucumbers under cold running water; drain. Remove stem and 1/16 inch from blossom ends of cucumbers. Finely chop cucumbers using a food processor or food grinder. Put chopped cucumbers in a bowl and sprinkle with salt and turmeric. Pour cold water over cucumbers just to cover. Cover; let stand 2 hours. Peel onion and finely chop. Drain cucumbers. Rinse chopped cucumbers under cold running water; drain.\n\nCOOK Combine cucumbers, onions, sugar, dill seed, and white wine vinegar in a large saucepan. Bring mixture to a boil, stirring until sugar dissolves. Reduce heat to a simmer; simmer 10 minutes.\n\nFILL Ladle hot relish into a hot jar, leaving 1/2-inch headspace. Add 1/8 teaspoon Pickle Crisp to a pint jar, if desired. Remove air bubbles. Clean jar rim. Center lid on jar and adjust band to fingertip-tight. Place jar on the rack in boiling-water canner with simmering water (180F). Repeat until all jars are filled.\n\nPROCESS Water must cover jars by 1 inch. Adjust heat to medium-high, cover canner, and bring water to a rolling boil. Process pint jars 15 minutes, adjusting for altitude. Turn off heat and remove cover. Let jars cool 5 minutes. Remove jars from canner; do not retighten bands if loose. Cool 12 hours. Check seals. Label and store jars.\n\n#canningrelish #canningcucumbers #waterbathcanning dillrelishrecipe Ball® and Ball logotype TMs Ball Corporation, used under license.","captionLanguage":"en","thumbnailMediaId":"med_5424ae223d1643c449c15b45f424","publishedAt":"2026-07-03T12:52:32.000Z","profileId":"prf_2076e9d8257a6b8b75d9bbf4fa82","thumbnailMediaUrl":"https://oriane-contents.s3.us-east-1.amazonaws.com/instagram/DaVNUVlwPil/thumbnail.webp","viewsCount":2665744,"likesCount":3572,"sharesCount":1417,"commentsCount":55,"interactionsCount":5044,"engagementRatePerViews":0.18921546855211904,"engagementRatePerFollowers":1.3703244876225251,"profileFollowersCount":368088,"profileFollowingCount":103,"profilePostsCount":224,"mediaCount":1,"duration":42.955,"hashtags":["#ad","#ballhomecanningambassador","#canningrelish","#canningcucumbers","#waterbathcanning"],"coAuthors":[{"id":"prf_0ed11747807756babf3e5b81376c","platformId":"405465375","profileHandle":"ballcanning"}],"mentions":[{"id":"prf_0ed11747807756babf3e5b81376c","platformId":"405465375","profileHandle":"ballcanning"}],"platformId":"DaVNUVlwPil","profilePlatformId":"62783572909","profilePictureUrl":"https://oriane-handles.s3.us-east-1.amazonaws.com/instagram/morethangardening/pfp.webp","profileBio":"Michigan - Zone 6a 👩🏼‍🌾\nGardening, canning, & more 🤠\nMy YouTube channel & favorite things ⤵️","profileVerified":true,"locationPlatformId":null,"locationCompleteAddress":null,"locationLatitude":null,"locationLongitude":null,"profileLocationPlatformId":null,"profileLocationCompleteAddress":null,"profileLocationLatitude":null,"profileLocationLongitude":null,"transcript":"looking for something to do with all of your garden cucumbers this summer other than pickles this recipe is for you just can't have this delicious dill relish from the makers of ball home canning and it is now my favorite condiment because it tastes really fresh really acidic and we're just absolutely loving it the recipe is super easy to make and it cans up super quickly in pint jars for only 15 minutes so whether you're a veteran canner or you're new to canning this season this is a easy beginner friendly one that i highly recommend this is one i'll be bringing over to family barbecues this season and we'll be adding it to all of our burgers and brats and i just can't wait for you guys to try it let me know what you think when you do as always the full recipe and instructions are in the caption this video and everything i'm using to make this is linked in my bio and in stories","transcriptLanguage":"en","transcriptChunks":[{"startSeconds":0.005,"endSeconds":3.845,"text":"looking for something to do with all of your garden cucumbers this summer other than pickles"},{"startSeconds":3.845,"endSeconds":8.565,"text":"this recipe is for you just can't have this delicious dill relish from the makers of ball"},{"startSeconds":8.565,"endSeconds":13.365,"text":"home canning and it is now my favorite condiment because it tastes really fresh really acidic and"},{"startSeconds":13.365,"endSeconds":18.245,"text":"we're just absolutely loving it the recipe is super easy to make and it cans up super quickly"},{"startSeconds":18.245,"endSeconds":22.965,"text":"in pint jars for only 15 minutes so whether you're a veteran canner or you're new to canning this"},{"startSeconds":22.965,"endSeconds":27.605,"text":"season this is a easy beginner friendly one that i highly recommend this is one i'll be bringing"},{"startSeconds":27.605,"endSeconds":32.165,"text":"over to family barbecues this season and we'll be adding it to all of our burgers and brats and i"},{"startSeconds":32.165,"endSeconds":37.125,"text":"just can't wait for you guys to try it let me know what you think when you do as always the full recipe"},{"startSeconds":37.125,"endSeconds":41.205,"text":"and instructions are in the caption this video and everything i'm using to make this is linked"},{"startSeconds":41.205,"endSeconds":51.205,"text":"in my bio and in stories"}],"frames":[{"id":"med_56396dfa3c4e3370b4ac7d75e2bb","position":1,"timestampSeconds":1.63,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DaVNUVlwPil/1_1.63.webp"},{"id":"med_9b67e9adb147e328b7c760bd6a7a","position":2,"timestampSeconds":2.43,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/instagram/DaVNUVlwPil/2_2.43.webp"},{"id":"med_3765912dc33c6e401b8a8247cb0a","position":3,"timestampSeconds":3.3,"url":"https://oriane-frames.s3.us-east-1.amazonaws.c