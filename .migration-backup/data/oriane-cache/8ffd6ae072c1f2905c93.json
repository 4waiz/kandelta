s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/28_31.57.webp"},{"id":"med_e836443ed2b12d87a7b4fdb74e97","position":29,"timestampSeconds":32.27,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/29_32.27.webp"},{"id":"med_45ee9903777da526745198607a33","position":30,"timestampSeconds":33.53,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/30_33.53.webp"},{"id":"med_22faab8001863478fa709e577e12","position":31,"timestampSeconds":34.07,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/31_34.07.webp"},{"id":"med_ac4908d0bc0aa001ae06faeb4a68","position":32,"timestampSeconds":35.37,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7659572405202849055/32_35.37.webp"}],"audioPlatformId":"7659572385733561119","audioTitle":"original sound","audioAuthor":"Lucy Smith","audioType":"original","audioCopyrighted":false,"popularComments":[{"platformId":"7660640886904570637","profilePlatformId":null,"profileHandle":"mchristine425","content":"Do you have a pizza 🍕 dough recipe?","likesCount":0,"repliesCount":0,"publishedAt":"2026-07-09T21:19:43.000Z","createdAt":"2026-07-14T02:28:41.626Z","updatedAt":"2026-07-14T02:28:41.626Z"},{"platformId":"7660231163625194254","profilePlatformId":null,"profileHandle":"thetessasmith","content":"The best!!!","likesCount":0,"repliesCount":0,"publishedAt":"2026-07-08T18:49:44.000Z","createdAt":"2026-07-14T02:28:41.626Z","updatedAt":"2026-07-14T02:28:41.626Z"}],"createdAt":"2026-07-13T14:07:32.628Z","updatedAt":"2026-09-25T08:44:23.569Z"},{"id":"cnt_0cbd0302aba9145f9e9590890972","matchedQueries":[],"platform":"tiktok","profileHandle":"lucymakes_","profileDisplayName":"Lucy Smith","format":"video","caption":"Homemade Red Hot Sauce from the makers of Ball® Home Canning!:) #ad Sooo insanely delicious on top of some crispy fried chicken🙌 #BallHomeCanningAmbassador I've had so much fun learning how to can lately with @ballcanning <3 If you’re wanting to start canning, now is the time! It's honestly way simpler than I imagined and it has been so fun starting to slowly stock our pantry with homemade long-lasting foods we love. Full recipe below! Red Hot Sauce Yield: about 4 half-pint jars Ingredients -2 quarts chopped tomatoes, (about 12 large) -1½ cups chopped red chili peppers (about 24) -1 quart white vinegar, 5% acidity, divided -1 cup sugar -2 tablespoons pickling spice -1 tablespoon salt for canning and pickling Note: When cutting or seeding hot peppers, wear rubber gloves to prevent hands from being burned. . Instructions: 1. PREP Wash tomatoes and red chili peppers under cold running water; drain. To peel tomatoes, blanch 30 to 60 seconds in boiling water. Immediately transfer to cold water. Remove peel. Remove core and chop tomatoes; measure 2 quarts chopped tomatoes. Remove stems from red chili peppers. Chop red chili peppers; measure 1½ cups chopped red chili peppers. Tie pickling spice in a spice bag. 2. COOK Combine tomatoes, red chili peppers, and 2 cups vinegar in a large saucepan. Bring mixture to a simmer; simmer until tomatoes are soft. Purée mixture using an electric food strainer or food mill. Pour purée into a large saucepan. Add spice bag, sugar, and salt. Simmer until sauce is reduced by half, stirring to prevent sticking. Add 2 cups vinegar and simmer to desired thickness, stirring to prevent sticking. Remove spice bag and discard. 3. FILL Ladle hot sauce into a hot jar, leaving ½-inch headspace. Remove air bubbles. Clean jar rim. Center lid on jar and adjust band to fingertip-tight. Place jar on the rack in boiling-water canner with simmering water (180°F). Repeat until all jars are filled. 4. PROCESS Water must cover jars by 1 inch. Adjust heat to medium-high, cover canner, and bring water to a rolling boil. Process half-pint jars 15 minutes, adjusting for altitude. Turn off heat and remove cover. Let jars cool 5 minutes. Remove jars from canner; do not retighten bands if loose. Cool 12 hours. Check seals. Label and store jars. Ball® and Ball logotype TMs Ball Corporation, used under license. #summerrecipes #homemaking #madefromscratch ","captionLanguage":"en","thumbnailMediaId":"med_a74b9def740d628eb25b6f8c3732","publishedAt":"2026-07-30T00:10:24.000Z","profileId":"prf_241952e580c51ba719d894be1ab3","thumbnailMediaUrl":"https://oriane-contents.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/thumbnail.webp","viewsCount":801000,"likesCount":4815,"sharesCount":136,"commentsCount":20,"interactionsCount":4971,"engagementRatePerViews":0.6205992509363296,"engagementRatePerFollowers":4.104872006606111,"profileFollowersCount":121100,"profileFollowingCount":694,"profilePostsCount":444,"mediaCount":1,"duration":43,"hashtags":["#ad","#ballhomecanningambassador","#summerrecipes","#homemaking","#madefromscratch"],"coAuthors":[],"mentions":[{"id":"prf_f138f9807e33d241dacc9c1c8c61","platformId":"6963284867053093894","profileHandle":"ballcanning"}],"platformId":"7668106644173147423","profilePlatformId":"6579680211489652742","profilePictureUrl":"https://oriane-handles.s3.us-east-1.amazonaws.com/tiktok/lucymakes_/pfp.webp","profileBio":"Passionate about good food, surfing,\n wellness, & being happy <3 \n💌lucymakes@illuminatesocial.co","profileVerified":false,"locationPlatformId":null,"locationCompleteAddress":null,"locationLatitude":null,"locationLongitude":null,"profileLocationPlatformId":null,"profileLocationCompleteAddress":null,"profileLocationLatitude":null,"profileLocationLongitude":null,"transcript":"Today we're making homemade hot sauce with ball home canning. This is such a good way to turn those summer tomatoes and chilies into something that will last all year long and upgrade any meal. I tried it on top of some fried chicken and it was absolutely insane. This spread hot sauce recipe comes from the 38th edition Ball Blue Book Guide to Preserving, where all the recipes are tested and approved for safety. The ingredients are very simple. We start by chopping up some tomatoes and chili peppers before cooking them together with vinegar. I've just recently started learning how to can and it's been so much fun. The best part for me has been only having to make something once and then having a stock of it in the pantry for months to come. For this recipe we are water bath canning, which just means we're going to briefly heat our filled jars in hot water, which will create a vacuum-tight seal to keep food safe for a long period of time. I'll put the full recipe in the caption, happy summer canning.","transcriptLanguage":"en","transcriptChunks":[{"startSeconds":0,"endSeconds":2.34,"text":"Today we're making homemade hot sauce with ball home canning."},{"startSeconds":2.5,"endSeconds":8.08,"text":"This is such a good way to turn those summer tomatoes and chilies into something that will last all year long and upgrade any meal."},{"startSeconds":8.2,"endSeconds":10.96,"text":"I tried it on top of some fried chicken and it was absolutely insane."},{"startSeconds":11.1,"endSeconds":15.12,"text":"This spread hot sauce recipe comes from the 38th edition Ball Blue Book Guide to Preserving,"},{"startSeconds":15.3,"endSeconds":17.68,"text":"where all the recipes are tested and approved for safety."},{"startSeconds":17.82,"endSeconds":19.04,"text":"The ingredients are very simple."},{"startSeconds":19.16,"endSeconds":23.18,"text":"We start by chopping up some tomatoes and chili peppers before cooking them together with vinegar."},{"startSeconds":23.34,"endSeconds":26.34,"text":"I've just recently started learning how to can and it's been so much fun."},{"startSeconds":26.34,"endSeconds":31.16,"text":"The best part for me has been only having to make something once and then having a stock of it in the pantry for months to come."},{"startSeconds":31.26,"endSeconds":35.8,"text":"For this recipe we are water bath canning, which just means we're going to briefly heat our filled jars in hot water,"},{"startSeconds":35.92,"endSeconds":39.74,"text":"which will create a vacuum-tight seal to keep food safe for a long period of time."},{"startSeconds":39.92,"endSeconds":42.2,"text":"I'll put the full recipe in the caption, happy summer canning."}],"frames":[{"id":"med_413d4a6c647ba1821d075c49653c","position":1,"timestampSeconds":1.1,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/1_1.10.webp"},{"id":"med_841d9868862452711eef5c70035a","position":2,"timestampSeconds":2.43,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/2_2.43.webp"},{"id":"med_71d581eb1ccdd47008a95b9cba08","position":3,"timestampSeconds":3.5,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/3_3.50.webp"},{"id":"med_eeb2d181e2b2ca0bd00873310bb0","position":4,"timestampSeconds":4.17,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/4_4.17.webp"},{"id":"med_d5191f148e82ff0bc40a1bc817b8","position":5,"timestampSeconds":4.9,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/5_4.90.webp"},{"id":"med_48b694de02a3646de64c9cbd9723","position":6,"timestampSeconds":5.83,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/6_5.83.webp"},{"id":"med_1d4fde2737ad052141254db729b4","position":7,"timestampSeconds":6.83,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/7_6.83.webp"},{"id":"med_6b0a501f6271f108b78c2a76499d","position":8,"timestampSeconds":7.9,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/8_7.90.webp"},{"id":"med_d138855c4fa7b29b99466b670719","position":9,"timestampSeconds":8.63,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/9_8.63.webp"},{"id":"med_ebab045dc79e46379892737abfa1","position":10,"timestampSeconds":9.07,"url":"https://oriane-frames.s3.us-east-1.amazonaws.com/tiktok/7668106644173147423/10_9.07.webp"},{"id":"med_fd842a2f1316